	partition Eras = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/eras.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"era", "label", "from", "to", "buildings", "share_of_dated", "floor_m2_est", "median_height_m"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"era", type text}, {"label", type text}, {"from", Int64.Type}, {"to", Int64.Type}, {"buildings", Int64.Type}, {"share_of_dated", type number}, {"floor_m2_est", type number}, {"median_height_m", type number}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
