table Eras
	lineageTag: dc1fcb4a-84b0-b953-d488-f402c1991310

	measure 'Era buildings' = SUM ( Eras[buildings] )
		formatString: #,0
		lineageTag: 0ec625e8-4de8-24ee-010c-118dcaca4b94

	/// Estimate, to compare eras only
	measure 'Era floor space m2' = SUM ( Eras[floor_m2_est] )
		formatString: #,0
		lineageTag: b402d0e4-6356-056c-05e1-4a274d3f17aa

	measure 'Era floor share' = DIVIDE ( [Era floor space m2], CALCULATE ( [Era floor space m2], ALL ( Eras ) ) )
		formatString: 0.0%
		lineageTag: e75520ab-e5f1-7cbd-eda7-1f7e78272a31

