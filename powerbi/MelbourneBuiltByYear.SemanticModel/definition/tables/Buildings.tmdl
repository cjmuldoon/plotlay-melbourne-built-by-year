	column use
		dataType: string
		lineageTag: c58cd2e0-16f1-570f-2d9d-0bc5df94e8fc
		summarizeBy: none
		sourceColumn: use

		annotation SummarizationSetBy = Automatic

	partition Buildings = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/buildings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"structure_id", "lat", "lng", "year", "floors", "height_m", "parts", "match", "address", "name", "use"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"structure_id", type text}, {"lat", type number}, {"lng", type number}, {"year", Int64.Type}, {"floors", Int64.Type}, {"height_m", type number}, {"parts", Int64.Type}, {"match", type text}, {"address", type text}, {"name", type text}, {"use", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
